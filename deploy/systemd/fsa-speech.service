# Speech runtime: /speech/* only. Same code and venv as fsa-face, its own process.
#
#   /etc/systemd/system/fsa-speech.service
#
# A second process rather than a second router in the first: failures, scaling,
# deployment, concurrency, rate limits, logs - and the native libraries, since
# PyAV and OpenCV each bring their own FFmpeg - stay apart from Face. The same
# unit runs one instance on the Face host, or many instances on hosts of their
# own behind a load balancer; nothing in the application changes.
#
# Sizing - worker processes, memory and CPU limits - is a deployment decision
# made for the hardware at hand. None of it lives here: see speech.env for the
# worker count and fsa-speech.service.d/limits.conf.example for optional limits.
[Unit]
Description=Face Similarity API - Speech runtime (STT + TTS)
After=network-online.target
Wants=network-online.target
# A crash loop is reported, not hidden.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=faceapi
Group=faceapi
# Deliberately not /opt/face-api/app: the settings loader also reads `.env` from
# the working directory, and the Face runtime's `.env` must not leak into this
# one. The code is found through --app-dir instead.
WorkingDirectory=/opt/face-api/speech
# Holds the Speech settings and WEB_CONCURRENCY, uvicorn's worker count.
EnvironmentFile=/opt/face-api/speech.env
Environment=FSA_RUNTIME_ROLE=speech
Environment=FSA_STT_ENABLED=true
Environment=FSA_TTS_ENABLED=true
# The model is provisioned before start (scripts/provision_stt_model.py); this
# process never downloads. A missing model is a fast 503, not a network wait.
Environment=HF_HUB_OFFLINE=1
# No --workers: uvicorn takes WEB_CONCURRENCY from the environment (default 1).
ExecStart=/opt/face-api/venv/bin/uvicorn app.main:app --app-dir /opt/face-api/app \
    --host 127.0.0.1 --port 8002 --timeout-keep-alive 65
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Read-only at runtime: nothing here writes outside PrivateTmp.

[Install]
WantedBy=multi-user.target
