# /opt/face-api/speech.env - the Speech runtime's own settings (mode 600, owner faceapi).
#
# Not /opt/face-api/app/.env: that file belongs to the Face runtime and this
# process never reads it. The role, both feature flags and HF_HUB_OFFLINE are
# set in the systemd unit itself, so nothing here can turn this runtime into
# something else.
#
# systemd reads this file as-is: no shell expansion, and a `#` mid-line is part
# of the value. Keep comments on their own lines.

FSA_DEBUG=false
FSA_LOG_LEVEL=INFO

# uvicorn worker processes (uvicorn's own variable; default 1). A deployment
# decision: each worker loads its own model and has its own semaphores and
# rate-limit counters, so capacity per host is workers x FSA_STT_MAX_CONCURRENT.
#WEB_CONCURRENCY=

# Its own key, so speech traffic is attributable and rotatable apart from Face.
# Laravel sends it as X-API-Key to /api/v1/speech/*.
FSA_API_KEYS=tenancy-app-speech:GANTI-DENGAN-KUNCI-ACAK
FSA_RATE_LIMIT_PER_MINUTE=60

# STT engine: what runs, and on what. All of it is configuration - a GPU host
# is `FSA_STT_DEVICE=cuda` with `FSA_STT_COMPUTE_TYPE=float16`, a bigger model is
# `FSA_STT_MODEL=medium`. FSA_STT_MODEL is a model name looked up in
# FSA_STT_MODEL_ROOT, or the absolute path of a model directory provisioned there.
FSA_STT_MODEL=small
FSA_STT_DEVICE=cpu
FSA_STT_COMPUTE_TYPE=int8
FSA_STT_MODEL_ROOT=/opt/face-api/models/stt

# STT capacity per worker, tuned per deployment: parallel transcriptions, and
# CPU threads for each (0 = library default). Threads in use per worker are
# FSA_STT_MAX_CONCURRENT x FSA_STT_CPU_THREADS.
FSA_STT_MAX_CONCURRENT=1
FSA_STT_CPU_THREADS=0

# STT API policy: what callers may send. Business decisions, not hardware ones.
FSA_STT_DEFAULT_LANGUAGE=id
FSA_STT_ALLOWED_LANGUAGES=id,en
FSA_STT_MAX_AUDIO_BYTES=26214400
FSA_STT_MAX_AUDIO_SECONDS=300

# TTS
FSA_TTS_DEFAULT_VOICE=default
FSA_TTS_TIMEOUT_SECONDS=30
FSA_TTS_MAX_CONCURRENT=4
