# Copy to .env and adjust. Every key is prefixed with FSA_.

# --- App ---------------------------------------------------------------------
FSA_APP_NAME="Face Similarity API"
FSA_DEBUG=false
FSA_LOG_LEVEL=INFO
FSA_API_PREFIX=/api/v1
# Comma separated, or "*" for any origin.
FSA_CORS_ORIGINS=*

# --- Access ------------------------------------------------------------------
# WAJIB diisi di produksi. Servis ini melakukan pengenalan wajah atas apa pun
# yang dikirim padanya, jadi port tanpa kunci bukan sekadar GPU gratis — siapa
# pun bisa mencocokkan foto orang. Kosong = servis menolak semua permintaan,
# kecuali FSA_DEBUG=true (jalur pengembangan lokal, dan diperingatkan saat boot).
#
# Format: `label:kunci`, dipisah koma. Label muncul di log agar sebuah permintaan
# bisa ditelusuri tanpa kuncinya sendiri pernah tertulis.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FSA_API_KEYS=
# Per kunci, per menit, dihitung di dalam satu proses. 0 mematikannya.
# Dua worker = dua hitungan; untuk batas yang benar-benar global, pakai nginx.
FSA_RATE_LIMIT_PER_MINUTE=60

# --- Face engine -------------------------------------------------------------
# buffalo_l = ArcFace R100 (most accurate), buffalo_s = smaller/faster.
FSA_MODEL_PACK=buffalo_l
# Where the ONNX models are cached. Defaults to ~/.insightface
# FSA_MODEL_ROOT=/app/models
# -1 = CPU, 0+ = CUDA device id.
FSA_CTX_ID=-1
FSA_DET_SIZE=640
FSA_MIN_DET_SCORE=0.55
FSA_MIN_FACE_PIXELS=40
FSA_MAX_CONCURRENT_INFERENCES=2
FSA_WARM_UP_ON_STARTUP=true
# 68-point landmark model. Required by /liveness/*; off saves memory.
FSA_ENABLE_LANDMARKS=true

# --- Reference images --------------------------------------------------------
FSA_MIN_REFERENCE_IMAGES=5
FSA_MAX_REFERENCE_IMAGES=5
FSA_MAX_IMAGE_BYTES=8388608
FSA_IMAGE_MAX_SIDE=1600
FSA_REFERENCE_COHESION_THRESHOLD=0.35

# --- Video -------------------------------------------------------------------
FSA_MAX_VIDEO_BYTES=67108864
FSA_MAX_VIDEO_SECONDS=60
FSA_MAX_SAMPLED_FRAMES=24
FSA_MAX_DECODED_FRAMES=1800
FSA_FRAME_MAX_SIDE=1280

# Frame yang dinilai, dikembalikan lewat `include_best_frame`. Kecil karena ia
# ikut di dalam respons JSON, base64.
FSA_BEST_FRAME_MAX_SIDE=640
FSA_BEST_FRAME_QUALITY=85

# --- Matching (tune these against your own data) -----------------------------
FSA_MATCH_THRESHOLD=0.38
FSA_FRAME_MATCH_THRESHOLD=0.38
FSA_MIN_MATCH_RATIO=0.6
FSA_TOP_K_RATIO=0.3
FSA_TOP_K_MIN_FRAMES=3
FSA_INCONCLUSIVE_BAND=0.03
FSA_MIN_FRAMES_WITH_FACE=3

# --- Matching untuk satu foto (endpoint /face/verify-image) ------------------
# Sebuah foto tidak punya frame untuk dirata-ratakan, jadi ketahanan yang pada
# klip didapat dari `FSA_TOP_K_RATIO` di sini diambil dari himpunan referensi:
# skor = rata-rata dari `FSA_IMAGE_TOP_K_REFERENCES` foto referensi terbaik.
# Merata-ratakan kelimanya menghukum enrolment yang memuat satu sudut buruk;
# mengambil satu yang terbaik membuat satu foto beruntung bisa meloloskan orang
# lain. Tiga dari lima meminta mayoritas setuju.
FSA_IMAGE_TOP_K_REFERENCES=3
# Berapa foto referensi yang harus lolos FSA_FRAME_MATCH_THRESHOLD sendiri-
# sendiri. Disamakan dengan FSA_IMAGE_TOP_K_REFERENCES: skor adalah rata-rata
# tiga terbaik, jadi tiga foto yang sama harus memikul rata-rata itu DAN lolos
# ambang masing-masing. Pada angka 2, minoritas bisa memikul mayoritas - dua
# foto orang lain di dalam satu himpunan referensi sudah cukup untuk absen
# sebagai pemiliknya.
FSA_MIN_REFERENCE_MATCHES=3

# --- Liveness challenge ------------------------------------------------------
# WAJIB diisi di produksi, dan harus sama di semua worker/instance.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FSA_CHALLENGE_SECRET=
FSA_CHALLENGE_TTL_SECONDS=120
FSA_CHALLENGE_ACTION_COUNT=2
# Pilihan: turn_left, turn_right, look_up, look_down, open_mouth, blink
# `blink` hanya andal kalau FSA_LIVENESS_MAX_SAMPLED_FRAMES tinggi (>= 60).
FSA_CHALLENGE_ACTIONS=turn_left,turn_right,look_up,look_down,open_mouth
# Berapa frame yang diambil untuk pemeriksaan liveness. Ini adalah biaya
# terbesar dari satu verifikasi, dan hampir satu-satunya. Diukur di CPU
# (buffalo_l) dengan klip 720x480 nyata dan 5 foto referensi:
#
#     60 frame -> 14.9 detik      36 frame -> 11.2 detik
#
# Panjang klip TIDAK berpengaruh - klip 5 detik dan 11 detik sama-sama 14.9
# detik - jadi memperpendek rekaman tidak mempercepat apa pun. Ukuran foto
# referensi juga tidak. Sekitar 154 ms per frame di atas biaya tetap ~5,6 detik.
#
# `blink` butuh 60: kedipan selesai dalam ~0,2 detik dan sampel yang lebih
# jarang akan melewatinya. Selama `blink` TIDAK ada di FSA_CHALLENGE_ACTIONS di
# atas, 36 aman - menoleh dan membuka mulut ditahan sekitar satu detik, yang
# masih tertangkap tiga sampai empat frame.
FSA_LIVENESS_MAX_SAMPLED_FRAMES=60
FSA_LIVENESS_MIN_FRAMES_WITH_FACE=8
FSA_LIVENESS_YAW_DELTA=0.30
FSA_LIVENESS_PITCH_DELTA=0.22
FSA_LIVENESS_BLINK_RATIO=0.7
FSA_LIVENESS_MOUTH_DELTA=0.12
